# GitHub — used by the Atlantis webhook tooling
GITHUB_ORG=your-github-handle
GITHUB_REPO=platform-infra
GITHUB_APP_ID=              # optional: use a GitHub App instead of a PAT
GITHUB_APP_INSTALLATION_ID=
GITHUB_PAT=                 # PAT with repo scope, for the webhook smoke test only

# Public tunnel to Atlantis (cloudflared quick tunnel when no account)
CLOUDFLARE_TUNNEL_TOKEN=     # optional; leave blank to use a quick tunnel
ATLANTIS_PORT=8080

# Local endpoints (defaults shown; override only if a port is taken)
ARGOCD_PORT=8081
GRAFANA_PORT=3000
VAULT_PORT=8200
MINISTACK_PORT=4566
REGISTRY_PORT=5000
