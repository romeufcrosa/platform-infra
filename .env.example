# GitHub — used by the Atlantis webhook tooling
# Optional: use a GitHub App instead of a PAT
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PAT with repo scope, for the webhook smoke test only
GITHUB_PAT=
GITHUB_ORG=your-github-handle
GITHUB_REPO=platform-infra

# Public tunnel to Atlantis (cloudflared quick tunnel when no account)
# Optional; leave blank to use a quick tunnel
CLOUDFLARE_TUNNEL_TOKEN=
ATLANTIS_PORT=8080

# Local endpoints (defaults shown; override only if a port is taken)
ARGOCD_PORT=8081
GRAFANA_PORT=3000
VAULT_PORT=8200
MINISTACK_PORT=4566
REGISTRY_PORT=5000
