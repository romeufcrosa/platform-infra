# Generated by OpenTofu (module argocd) — do not edit by hand; edit the
# .tftpl template instead. Regenerated on every apply so the repoURL always
# matches this machine's configuration.
#
# This file is NOT how the Application gets created. It is the same manifest
# as `kubernetes_manifest.bootstrap_application`, rendered a second time so
# the repo and the cluster cannot drift; the `kubernetes_manifest` is what
# creates the object. "Committed so ArgoCD has something to read on the very
# first sync" is circular — the Application that would read it is itself
# never created by a file.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: platform-system
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: platform-system
  source:
    repoURL: ${repo_url}
    targetRevision: main
    path: kubernetes/platform-system
    # `directory.recurse: true` is in the template as well as in the
    # hand-written YAML above. It used to be only in the hand-written copy,
    # and `local_file` overwrites that file on the first apply — a field that
    # exists only in the file that gets overwritten is a field that silently
    # disappears.
    directory:
      recurse: true
  # Disable server-side Kustomize which requires the kustomize.config.k8s.io
  # CRD (a protected API group that cannot be installed manually). Use
  # client-side Kustomize instead: ArgoCD runs `kustomize build` locally and
  # applies the resulting manifests directly.
  destination:
    server: https://kubernetes.default.svc
    namespace: platform-system
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - PruneLast=true
      - ServerSideKustomize=false
  ignoreDifferences:
    # OpenTofu writes these labels; ArgoCD must not fight it over them. Any
    # label OpenTofu owns and ArgoCD does not agree on is a permanent diff.
    # This block has to be in the TEMPLATE, not just in Step 4's hand-written
    # YAML: `local_file` overwrites that file with this rendering, so a block
    # present only in the hand-written version is a block that silently
    # disappears on the first `tofu apply`.
    - group: v1
      kind: Namespace
      jsonPointers:
        - /metadata/labels/platform~1environment
        - /metadata/labels/app.kubernetes.io~1managed-by
        - /metadata/labels/app.kubernetes.io~1part-of
