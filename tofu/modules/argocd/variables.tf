variable "namespace" {
  description = "Namespace for ArgoCD. Matches the chart's install namespace."
  type        = string
  default     = "argocd"
}

variable "chart_version" {
  description = "Pinned argo-cd chart version."
  type        = string
  default     = "6.7.18"
}

variable "timeout" {
  description = "Helm timeout in seconds."
  type        = number
  default     = 600
}

variable "admin_password" {
  description = "ArgoCD admin password, seeding a fresh checkout. Empty = generated by OpenTofu. Read once: after the first apply local-secrets/argocd-admin-password is the source of truth, because re-hashing a caller-supplied password on every plan would change the chart's stored admin password every time."
  type        = string
  default     = ""
  sensitive   = true
}

variable "enable_service_monitor" {
  description = <<-EOT
    Whether the chart renders argocd-server's ServiceMonitor. False in Task 6,
    true in Task 8. It cannot simply be left on: the ServiceMonitor template is
    gated on the monitoring.coreos.com/v1 CRD being present at render time, and
    Task 6 runs in parallel with the task that installs it. A Task 6 that
    applies first records the omission in Helm's release secret, so the
    ServiceMonitor never appears even after Prometheus is installed.
  EOT
  type        = bool
  default     = false
}

variable "repo_url" {
  description = "Git URL of platform-infra, as registered with ArgoCD."
  type        = string
}

variable "repo_username" {
  description = "Username for the Git host."
  type        = string
  default     = "git"
}

variable "repo_password" {
  description = "PAT for the Git host. Empty for public repos or InCluster SSH."
  type        = string
  default     = ""
  sensitive   = true
}

variable "namespace_dependency" {
  description = "Explicit dependency so the namespace exists before the chart installs."
  type        = any
  default     = null
}

# --- Paths OUTSIDE the root module ------------------------------------------
#
# The brief spells both of these as inline `path.module` expressions:
#
#   values          = [file("${path.module}/../../helm/values/argocd.yaml")]
#   fileexists("${path.module}/../../../local-secrets/argocd-admin-password")
#
# Neither works. OpenTofu's `file()` and `fileexists()` are confined to the
# ROOT module directory — `tofu/` here. `helm/` and `local-secrets/` are its
# siblings, above it, and every such call fails. Verified against OpenTofu
# 1.7.0 with a scratch module: `file()` returns
# "Invalid value for \"path\" parameter: no file exists at ...; this function
# works only with files that are distributed as part of the configuration
# source code", and `fileexists()` returns **false even when the file exists**.
# `abspath()` does not help.
#
# The loud half is the values file: `tofu validate` fails outright, which is
# why it was found. The quiet half is far worse. `fileexists()` returning a
# hardcoded `false` for `local-secrets/argocd-admin-password` means the
# read-back branch above it is DEAD CODE on every run after the first, so
# `bcrypt()` re-salts on every plan, `admin.password` in argocd-secret changes
# on every apply, and `local_file.admin_password_hash` rewrites itself on every
# apply. That is precisely the churn the "generate once, persist, read back"
# shape exists to prevent — and it would have passed `tofu validate`, lint,
# review and plan, because the plan would simply always show a diff and nobody
# would know why.
#
# A path handed to `file()` THROUGH A VARIABLE is exempt from the restriction.
# Verified against OpenTofu 1.7.0: `file(var.p)` reads
# `../outside-dir/values.yaml` and `fileexists(var.p)` returns true, where the
# identical literal written inline is refused. So the value is a variable and
# the file operations hang off it.
variable "values_file" {
  description = <<-EOT
    Path to the chart's values file, which lives outside the OpenTofu root
    module and is therefore only readable through this variable. See the note
    above.
  EOT
  type        = string
  default     = "../helm/values/argocd.yaml"
}

variable "local_secrets_dir" {
  description = <<-EOT
    Gitignored directory the admin password and its bcrypt hash are written
    to. Shared with Task 9 (Vault root token) and Task 10 (Atlantis webhook
    secret) — one `local-secrets/`, because the .gitignore rule and the
    runbooks both name that path. Outside the OpenTofu root module; see the
    note above for why it is a variable.
  EOT
  type        = string
  default     = "../local-secrets"
}
