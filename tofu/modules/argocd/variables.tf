variable "namespace" {
  description = "Namespace for ArgoCD. Matches the chart's install namespace."
  type        = string
  default     = "argocd"
}

variable "chart_version" {
  description = "Pinned argo-cd chart version."
  type        = string
  default     = "6.7.18"
}

variable "timeout" {
  description = "Helm timeout in seconds."
  type        = number
  default     = 600
}

variable "admin_password" {
  description = "ArgoCD admin password, seeding a fresh checkout. Empty = generated by OpenTofu. Read once: after the first apply local-secrets/argocd-admin-password is the source of truth, because re-hashing a caller-supplied password on every plan would change the chart's stored admin password every time."
  type        = string
  default     = ""
  sensitive   = true
}

variable "enable_service_monitor" {
  description = <<-EOT
    Whether the chart renders argocd-server's ServiceMonitor. False in Task 6,
    true in Task 8. It cannot simply be left on: the ServiceMonitor template is
    gated on the monitoring.coreos.com/v1 CRD being present at render time, and
    Task 6 runs in parallel with the task that installs it. A Task 6 that
    applies first records the omission in Helm's release secret, so the
    ServiceMonitor never appears even after Prometheus is installed.
  EOT
  type        = bool
  default     = false
}

variable "repo_url" {
  description = "Git URL of platform-infra, as registered with ArgoCD."
  type        = string
}

variable "repo_username" {
  description = "Username for the Git host."
  type        = string
  default     = "git"
}

variable "repo_password" {
  description = "PAT for the Git host. Empty for public repos or InCluster SSH."
  type        = string
  default     = ""
  sensitive   = true
}

variable "namespace_dependency" {
  description = "Explicit dependency so the namespace exists before the chart installs."
  type        = any
  default     = null
}

# --- Paths OUTSIDE the root module ------------------------------------------
#
# `helm/` and `local-secrets/` are siblings of the root module, not children
# of it, so the paths reaching them are not `path.module`-relative. They are
# plain paths relative to the root module, passed as variables.
#
# **An earlier version of this comment claimed something false, and the claim
# was expensive.** It asserted that OpenTofu's `file()` and `fileexists()` are
# confined to the root module directory, that `fileexists()` "returns false
# even when the file exists", and that a path passed *through a variable* is
# exempt from a restriction that an identical inline literal is subject to. It
# cited "verified against OpenTofu 1.7.0" and described how it was verified.
#
# None of that is true. Re-tested 2026-09-27 on OpenTofu 1.7.0 with a scratch
# module, on a file that definitely existed:
#
#   fileexists("/abs/path/outside/root/module/probe.txt")  -> true
#   file("/abs/path/outside/root/module/probe.txt")         -> "hello"
#   fileexists(var.p)  with var.p = that same path          -> true
#   file(var.p)                                            -> "hello"
#
# The inline literal and the variable form behave identically. There is no
# confinement and no exemption.
#
# Why the false claim was so convincing, and how to avoid repeating it: the
# original test used a path whose file had not been created, so `false` came
# back — indistinguishable from "the function refuses paths outside the root
# module". **Prove the fixture exists before concluding anything about a
# function's reach.** This is the same mistake as the F4 guard mutation
# earlier in this project, made twice in one day by two different agents: a
# test that could not distinguish "refused" from "absent" was read as a
# finding about the tool rather than about the test.
#
# The variable is kept because a configurable path is worth having on its own
# terms, not because the inline form would not have worked.
variable "values_file" {
  description = <<-EOT
    Path to the chart's values file, relative to the root module. A variable
    because the path is worth being able to override; see the note above.
  EOT
  type        = string
  default     = "../helm/values/argocd.yaml"
}

variable "local_secrets_dir" {
  description = <<-EOT
    Gitignored directory the admin password and its bcrypt hash are written
    to. Shared with Task 9 (Vault root token) and Task 10 (Atlantis webhook
    secret) — one `local-secrets/`, because the .gitignore rule and the
    runbooks both name that path. Outside the OpenTofu root module; see the
    note above for why it is a variable.
  EOT
  type        = string
  default     = "../local-secrets"
}
